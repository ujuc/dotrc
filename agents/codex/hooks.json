{
  "description": "Shared dotrc hooks for Codex.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.config/dotrc/agents/codex/hooks/graft/graft-hooks.cjs session-start",
            "timeout": 10000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.config/dotrc/agents/codex/hooks/graft/graft-hooks.cjs prompt",
            "timeout": 15000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.config/dotrc/agents/codex/hooks/graft/graft-hooks.cjs post-edit",
            "timeout": 10000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.config/dotrc/agents/codex/hooks/graft/graft-hooks.cjs stop",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
