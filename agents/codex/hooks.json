{
  "description": "Shared dotrc workflow hooks for Codex.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/workflow-hooks hook",
            "timeout": 30,
            "additionalContextLimit": 1000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/workflow-hooks hook",
            "timeout": 30,
            "additionalContextLimit": 500
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/workflow-hooks hook",
            "timeout": 30,
            "additionalContextLimit": 1000
          }
        ]
      }
    ]
  }
}
