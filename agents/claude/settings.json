{
  "respectGitignore": true,
  "skillListingBudgetFraction": 0.05,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDISH_MD_MODE": "sibling"
  },
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(git -C:*)",
      "Bash(gh:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(echo:*)",
      "Bash(grep:*)",
      "Bash(which:*)",
      "Bash(command -v:*)",
      "Bash(env)",
      "Bash(date:*)",
      "Bash(uv:*)",
      "Bash(brew bundle:*)",
      "Bash(mise which:*)",
      "Bash(ollama list:*)",
      "Bash(waza:*)",
      "Bash(yq:*)",
      "Bash(chmod +x:*)",
      "Bash(mkdir:*)",
      "Bash(ln:*)",
      "Bash(cat:*)",
      "Bash(jq:*)",
      "Bash(mv:*)",
      "Bash(rmdir:*)",
      "Bash(cd:*)",
      "WebFetch(domain:agents.md)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:github.blog)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebSearch",
      "mcp__acp__Write",
      "mcp__acp__Edit",
      "mcp__acp__Bash",
      "Skill(commit)",
      "Skill(commit:*)"
    ],
    "deny": [],
    "ask": [
      "Bash(git push:*)"
    ],
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/skill-improver-cadence.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/clarify-update-word.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/annotation-review-prompt.sh"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/polyglot-typecheck.sh",
            "timeout": 30000
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/preserve-research-context.sh"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "bash -c 'plugin_dir=$(ls -d \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}\"/plugins/cache/claude-hud/claude-hud/*/ 2>/dev/null | sed \"s:/*$:/:\" | awk -F/ '\"'\"'{ print $(NF-1) \"\\t\" $0 }'\"'\"' | sort -t. -k1,1n -k2,2n -k3,3n -k4,4n | tail -1 | cut -f2-); exec \"$(\"$HOME/.local/bin/mise\" which bun)\" \"${plugin_dir}src/index.ts\"'"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "claude-hud@claude-hud": true,
    "security-guidance@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "ecc@ecc": false,
    "typescript-lsp@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": false,
    "explanatory-output-style@claude-plugins-official": false,
    "remember@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": false,
    "fable-advisor@fable-advisor": true,
    "ponytail@ponytail": true,
    "claudish-to-english@gvzdv-plugins": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    },
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    },
    "ecc": {
      "source": {
        "source": "git",
        "url": "https://github.com/affaan-m/ECC.git"
      }
    },
    "fable-advisor": {
      "source": {
        "source": "github",
        "repo": "DannyMac180/fable-advisor"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "gvzdv-plugins": {
      "source": {
        "source": "github",
        "repo": "gvzdv/claudish-to-english"
      }
    }
  },
  "outputStyle": "explanatory-concise",
  "language": "한국어",
  "spinnerTipsEnabled": false,
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "advisorModel": "opus",
  "askUserQuestionTimeout": "5m",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "editorMode": "normal",
  "teammateMode": "tmux",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "useAutoModeDuringPlan": true
}
