#!/usr/bin/env bash
# register-skill — Thin launcher that defers to the Rust workspace under tools/.
# Usage: register-skill <readme-path> --name <skill> --group <slug>

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TOOLS_DIR="${SCRIPT_DIR}/../tools"

if ! command -v cargo >/dev/null 2>&1; then
  echo "error: cargo not found. Install Rust via rustup: https://rustup.rs" >&2
  exit 127
fi

exec cargo run \
  --manifest-path "${TOOLS_DIR}/Cargo.toml" \
  --bin register-skill \
  --quiet \
  -- "$@"
