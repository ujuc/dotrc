#!/usr/bin/env bash
# superpowers-upstream — Report whether upstream writing-skills moved past the commit guidance-testing.md adapts.
# Usage:
#   superpowers-upstream check   # advisory; always exits 0 and prints one "- writing-skills: ..." line
#   superpowers-upstream test    # offline self-check of the report logic

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REFERENCE="${SCRIPT_DIR}/../references/guidance-testing.md"
REPO="obra/superpowers"
TRACKED_PATH="skills/writing-skills"

pinned() {
  sed -n 's/^source_commit: \([0-9a-f]*\).*/\1/p' "${REFERENCE}" | head -1
}

latest() {
  curl -fsSL --max-time 15 "https://api.github.com/repos/${REPO}/commits?path=${TRACKED_PATH}&per_page=1" 2>/dev/null |
    jq -r '.[0].sha // empty' 2>/dev/null
}

# report PINNED LATEST: one status line.
report() {
  local pin="$1" head="$2"
  if [ -z "${head}" ]; then
    echo "- writing-skills: upstream unreachable; pinned ${pin:-unknown}"
  elif [ -n "${pin}" ] && [ "${head#"${pin}"}" != "${head}" ]; then
    echo "- writing-skills: up to date (${pin})"
  else
    echo "- writing-skills: update available ${pin:-unknown} -> ${head:0:12}; review https://github.com/${REPO}/compare/${pin}...${head:0:12} and update guidance-testing.md"
  fi
}

case "${1:-}" in
  check)
    report "$(pinned)" "$(latest)"
    ;;
  test)
    fail=0
    expect() { [ "$2" = "$3" ] || { echo "FAIL $1: $3"; fail=1; }; }
    expect "same commit" "- writing-skills: up to date (abc123)" "$(report abc123 abc123def456)"
    expect "no network" "- writing-skills: upstream unreachable; pinned abc123" "$(report abc123 '')"
    case "$(report abc123 def456000000999)" in
      *"update available abc123 -> def456000000;"*) ;;
      *) echo "FAIL newer commit"; fail=1 ;;
    esac
    case "$(report '' def456000000999)" in
      *"update available unknown"*) ;;
      *) echo "FAIL missing pin"; fail=1 ;;
    esac
    [ -n "$(pinned)" ] || { echo "FAIL source_commit missing from guidance-testing.md"; fail=1; }
    [ "${fail}" -eq 0 ] && echo "superpowers-upstream: self-check ok"
    exit "${fail}"
    ;;
  *)
    sed -n '2,5p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]
    ;;
esac
