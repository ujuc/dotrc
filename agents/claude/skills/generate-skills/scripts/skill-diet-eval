#!/usr/bin/env bash
# skill-diet-eval — Thin launcher for the vendored skill-diet eval.mjs (the only node entry point).
# Usage: skill-diet-eval check <skill-dir> | calibrate <dir> | run <dir> [...] | score <dir> [--detail] | --help

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
EVAL_MJS="${SCRIPT_DIR}/../../skill-diet/scripts/eval.mjs"

if ! command -v node >/dev/null 2>&1; then
  echo "error: node not found. skill-diet's eval.mjs needs Node.js 18+." >&2
  exit 127
fi

exec node "${EVAL_MJS}" "$@"
