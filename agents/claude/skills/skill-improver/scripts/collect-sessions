#!/usr/bin/env bash
# Collect recent Claude Code sessions and condense them for Dimension E.
set -euo pipefail

usage() {
  cat <<'EOF'
Collect recent Claude Code sessions and condense them for Dimension E.

Usage: collect-sessions --out DIR [--since YYYY-MM-DD] [--max N] [--scan N]
                        [--project PATH]... [--include-sidechains]

Defaults: 45-day window, 12 sampled sessions, 60 scanned files; sidechains excluded.
--max and --scan must be positive integers.
Writes DIR/transcripts/<session-id>.txt and DIR/inventory.json.
Use a local mktemp directory; never upload, commit, or quote session digests.
EOF
}

die() {
  printf 'collect-sessions: %s\n' "$1" >&2
  exit "${2:-2}"
}

require_value() {
  [ "$#" -ge 2 ] && [ -n "$2" ] && [[ "$2" != --* ]] \
    || die "$1 requires a value (see --help)"
}

matches_project() {
  local cwd=$1 prefix
  [ "${#projects[@]}" -gt 0 ] || return 0
  for prefix in "${projects[@]}"; do
    case "$cwd" in "$prefix"|"$prefix"/*) return 0 ;; esac
  done
  return 1
}

# Preserve both ends: setup mistakes cluster at the start, corrections at the end.
cap_digest() {
  local digest=$1 lines=$2 half=$((digest_cap / 2))
  [ "$lines" -gt "$digest_cap" ] || return 0
  {
    head -n "$half" "$digest"
    printf '%s\n' "--- $((lines - digest_cap)) lines elided: digest capped at $digest_cap ---"
    tail -n "$half" "$digest"
  } >"$digest.part"
  mv "$digest.part" "$digest"
}

here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
projects_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects"

out=""
since=""
max=12
scan=60
sidechains=0
projects=()
digest_cap=400

while [ $# -gt 0 ]; do
  case "$1" in
    --out|--since|--max|--scan|--project)
      require_value "$@"
      case "$1" in
        --out)     out=$2 ;;
        --since)   since=$2 ;;
        --max)     max=$2 ;;
        --scan)    scan=$2 ;;
        --project) projects+=("$2") ;;
      esac
      shift 2
      ;;
    --include-sidechains) sidechains=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown argument: $1 (see --help)" ;;
  esac
done

[ -n "$out" ] || die "--out DIR is required (see --help)"
for option in max scan; do
  value=${!option}
  [[ "$value" =~ ^[0-9]+$ ]] && [ "$value" -gt 0 ] 2>/dev/null \
    || die "--$option must be a positive integer"
done
command -v jq >/dev/null || die "jq is required" 1
[ -d "$projects_dir" ] || die "no session history at $projects_dir" 1

# Cadence timestamps record when the user was asked, not which sessions were read.
[ -n "$since" ] || since=$(date -u -v-45d +%F 2>/dev/null || date -u -d '45 days ago' +%F)

# BSD and GNU stat disagree on the mtime format flag; pick once.
if stat -f '%m' . >/dev/null 2>&1; then
  stat_fmt=(-f '%m %N')
else
  stat_fmt=(-c '%Y %n')
fi

mkdir -p "$out/transcripts"
: >"$out/.sessions.ndjson"

scanned=0
sampled=0
while IFS= read -r file; do
  [ -n "$file" ] || continue
  [ "$scanned" -lt "$scan" ] || break
  scanned=$((scanned + 1))

  meta=$(jq -nR -f "$here/inventory.jq" "$file") || continue
  id=$(jq -r '.session_id' <<<"$meta")
  cwd=$(jq -r '.cwd' <<<"$meta")
  [ -n "$id" ] || continue

  # A session with no human turn or almost no tool work has nothing to score.
  jq -e '.user_turns >= 1 and .tool_calls >= 3' <<<"$meta" >/dev/null || continue

  matches_project "$cwd" || continue

  digest="$out/transcripts/$id.txt"
  jq -rR --arg sidechains "$sidechains" -f "$here/condense.jq" "$file" >"$digest"

  lines=$(wc -l <"$digest" | tr -d ' ')
  cap_digest "$digest" "$lines"

  jq -c --arg path "$digest" --argjson full "$lines" \
     '. + {digest: $path, digest_lines: $full}' <<<"$meta" >>"$out/.sessions.ndjson"

  sampled=$((sampled + 1))
  [ "$sampled" -lt "$max" ] || break
done < <(find "$projects_dir" -type f -name '*.jsonl' -newermt "$since" -exec stat "${stat_fmt[@]}" {} + \
         | sort -rn | cut -d' ' -f2-)

jq -s --arg generated "$(date -u +%FT%TZ)" --arg since "$since" \
      --argjson scanned "$scanned" --argjson sampled "$sampled" \
   '{generated_at: $generated, window_since: $since,
     sessions_scanned: $scanned, sessions_sampled: $sampled, sessions: .}' \
   "$out/.sessions.ndjson" >"$out/inventory.json"
rm -f "$out/.sessions.ndjson"

echo "collect-sessions: sampled $sampled of $scanned scanned sessions since $since -> $out"
